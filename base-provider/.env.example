# Base Provider Environment Configuration
# Copy this file to .env and update with your values

# Provider Configuration
PROVIDER_TYPE=openai
MODEL=gpt-3.5-turbo
API_KEY=sk-your-api-key-here
API_BASE_URL=https://api.openai.com/v1

# Optional: OpenAI Organization
ORGANIZATION=

# Optional: Request Settings
TIMEOUT=30
MAX_RETRIES=3
TEMPERATURE=0.7
MAX_TOKENS=2000

# ============================================================================
# Alternative: Local LM Configuration Examples
# ============================================================================

# For Ollama (http://localhost:11434/v1):
# PROVIDER_TYPE=openai
# MODEL=llama2
# API_KEY=not-needed
# API_BASE_URL=http://localhost:11434/v1

# For LocalAI (http://localhost:8080/v1):
# PROVIDER_TYPE=openai
# MODEL=gpt4all-j
# API_KEY=not-needed
# API_BASE_URL=http://localhost:8080/v1

# For vLLM (http://localhost:8000/v1):
# PROVIDER_TYPE=openai
# MODEL=meta-llama/Llama-2-7b-chat-hf
# API_KEY=not-needed
# API_BASE_URL=http://localhost:8000/v1

# For Custom Endpoint:
# PROVIDER_TYPE=openai
# MODEL=custom-model
# API_KEY=your-api-key
# API_BASE_URL=http://127.0.0.1:1234/v1

# ============================================================================
# With Custom Prefix (BOT_)
# ============================================================================

# BOT_PROVIDER_TYPE=openai
# BOT_MODEL=gpt-4
# BOT_API_KEY=sk-your-key
# BOT_API_BASE_URL=https://api.openai.com/v1
# BOT_TEMPERATURE=0.7
# BOT_MAX_TOKENS=2000
