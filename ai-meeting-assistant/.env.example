# Environment variables for AI Meeting Assistant
# The application now uses base-provider for flexible LLM configuration

# Option 1: Simple configuration (recommended)
# Uses OpenAI API by default
OPENAI_API_KEY=your_api_key_here

# Option 2: Advanced configuration with base-provider
# Uncomment to override default settings
# MEETING_ASSISTANT_PROVIDER_TYPE=openai
# MEETING_ASSISTANT_MODEL=gpt-3.5-turbo
# MEETING_ASSISTANT_API_KEY=your_api_key_here
# MEETING_ASSISTANT_TEMPERATURE=0.5
# MEETING_ASSISTANT_MAX_TOKENS=2000

# Option 3: Local LM (requires local server)
# MEETING_ASSISTANT_PROVIDER_TYPE=openai
# MEETING_ASSISTANT_MODEL=llama2
# MEETING_ASSISTANT_API_KEY=not-needed
# MEETING_ASSISTANT_API_BASE_URL=http://localhost:11434/v1
